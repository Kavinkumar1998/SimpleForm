@model SimpleForm.Models.User

<form asp-controller="Home" asp-action="Create" method="post">
   
    <label asp_for="Name"  >Name:</label>
    <input type="text" id="Name" name="Name" />
    
    <label asp_for="Email" >Email:</label>
    <input type="email" id="Email" name="Email" />

    <label asp_for="PhoneNumber">Phone Number:</label>
    <input type="tel" id="PhoneNumber" name="PhoneNumber" />

    <label asp_for="Town">Town:</label>
    <input type="text" id="Town" name="Town" />

    <label asp_for="City">City:</label>
    <input type="text" id="City" name="City" />

    <label asp_for="State">State:</label>
    <input type="text" id="State" name="State" />

    <label asp_for="Country">Country:</label>
    <input type="text" id="Country" name="Country" />

    <input type="submit" value="Create" />
</form>
